      "sha256": "F0B046E604732D52F8DA445DDFE9FCA2F2CA4B525D47151859F2EA30E75620A7"
    },
    {
      "id": "news-03",
      "kind": "news",
      "file": "Assets/TaskPlatform/Media/News/news-03.wav",
      "duration": 9.284542,
      "voice": "Microsoft David Desktop",
      "text": "A Mars rover is studying dust on spacesuit samples. The findings could help researchers design better protection for future astronauts.",
      "sourcePage": "https://www.jpl.nasa.gov/news/nasas-perseverance-offers-clues-to-protect-crews-from-mars-dust/",
