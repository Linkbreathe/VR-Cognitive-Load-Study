      "kind": "news",
      "file": "Assets/TaskPlatform/Media/News/news-02.wav",
      "duration": 9.194563,
      "voice": "Microsoft Zira Desktop",
      "text": "Voyager One is saving power as its journey continues. Engineers have also resolved a brief interruption in communications with the spacecraft.",
